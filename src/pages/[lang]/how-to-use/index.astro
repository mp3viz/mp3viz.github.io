---
import HowToUseView from '../../../components/HowToUseView.astro';
import { NON_DEFAULT_LOCALES, type Locale } from '../../../i18n/translations';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
---

<HowToUseView locale={lang as Locale} />
