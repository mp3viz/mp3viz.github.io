---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { TRANSLATIONS, type Locale, getLocalizedPath } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = TRANSLATIONS[locale];
const siteOrigin = 'https://mp3viz.github.io';
const homePath = getLocalizedPath(locale, '');
const currentPath = getLocalizedPath(locale, 'hire-me/');
const homeUrl = new URL(homePath, siteOrigin).toString();
const canonicalUrl = new URL(currentPath, siteOrigin).toString();

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t.nav.home,
      item: homeUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t.hireMe.breadcrumbCurrent,
      item: canonicalUrl,
    },
  ],
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Kishara Dilshan',
  url: canonicalUrl,
  email: 'mailto:kisharadilshan007@gmail.com',
  jobTitle: 'Full-Stack Web & Client-Side Media Developer',
  knowsAbout: [
    'Astro',
    'React',
    'Next.js',
    'TypeScript',
    'WebAssembly',
    'Web Audio API',
    'WebCodecs',
    'Technical SEO',
    'UI/UX Design',
  ],
};
---

<BaseLayout
  locale={locale}
  route="hire-me/"
  title={t.hireMe.title}
  description={t.hireMe.description}
  schemas={[breadcrumbSchema, personSchema]}
>
  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-14">
    <Breadcrumbs locale={locale} currentLabel={t.hireMe.breadcrumbCurrent} />

    <div class="rounded-3xl border border-line bg-card p-6 sm:p-10 shadow-studio dark:shadow-studio-dark">
      <!-- Single Semantic H1 Pairing Freelance Status Badge + Display Heading -->
      <h1>
        <span class="inline-flex items-center gap-2 rounded-full border border-line bg-subtle px-4 py-1.5 text-xs sm:text-sm font-bold text-ink">
          <span class="relative flex h-2.5 w-2.5">
            <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-500 animate-pulse-ring"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
          </span>
          {t.hireMe.badge}
        </span>
        <span class="mt-5 block text-3xl font-extrabold tracking-tight text-ink sm:text-4xl lg:text-[2.65rem] lg:leading-[1.15]">
          {t.hireMe.heading}
        </span>
      </h1>

      <p class="mt-5 text-lg sm:text-xl font-semibold text-ink">
        {t.hireMe.intro}
      </p>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-muted">
        {t.hireMe.subcopy}
      </p>

      <!-- Specialties Grid -->
      <div class="mt-8">
        <h2 class="sr-only">{t.hireMe.specialtiesHeading}</h2>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          {t.hireMe.specialties.map((item, idx) => (
            <div class="flex flex-col rounded-2xl border border-line bg-page p-5 sm:p-6">
              <div class="mb-3.5 flex h-11 w-11 items-center justify-center rounded-xl bg-accent text-accent-fg shadow-xs">
                {idx === 0 && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                  </svg>
                )}
                {idx === 1 && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="4" y="4" width="16" height="16" rx="2" />
                    <rect x="9" y="9" width="6" height="6" />
                    <path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3" />
                  </svg>
                )}
                {idx === 2 && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <path d="M3 9h18" />
                    <path d="M9 21V9" />
                  </svg>
                )}
              </div>
              <h3 class="text-base font-bold leading-snug text-ink">
                {item.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- Direct Email & One-Click Copy CTA -->
      <div class="mt-10 rounded-2xl border border-line bg-subtle/65 p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-extrabold text-ink">
          {t.hireMe.ctaHeading}
        </h2>

        <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <a
            href={`mailto:${t.hireMe.email}`}
            class="inline-flex min-h-[48px] items-center justify-center gap-2.5 rounded-xl bg-accent px-5 py-3 text-sm sm:text-base font-bold text-accent-fg hover:bg-accent-hover shadow-sm studio-transition"
          >
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
            <span>{t.hireMe.emailLabel}</span>
          </a>

          <button
            type="button"
            id="copy-email-btn"
            data-email={t.hireMe.email}
            data-copy-label={t.hireMe.copyButtonLabel}
            data-copied-label={t.hireMe.copiedButtonLabel}
            aria-label={`${t.hireMe.copyButtonLabel}: ${t.hireMe.email}`}
            class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-xl border border-line bg-card px-5 py-3 text-sm font-bold text-ink hover:bg-page studio-transition"
          >
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <span id="copy-email-text">{t.hireMe.copyButtonLabel}</span>
          </button>
        </div>

        <p id="copy-email-live" role="status" aria-live="polite" class="sr-only"></p>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var btn = document.getElementById('copy-email-btn');
      var textSpan = document.getElementById('copy-email-text');
      var live = document.getElementById('copy-email-live');
      if (!btn || !textSpan) return;

      btn.addEventListener('click', function () {
        var email = btn.getAttribute('data-email') || 'kisharadilshan007@gmail.com';
        var copyLabel = btn.getAttribute('data-copy-label') || 'Copy Email';
        var copiedLabel = btn.getAttribute('data-copied-label') || 'Copied!';

        function markCopied() {
          textSpan.textContent = copiedLabel;
          if (live) live.textContent = copiedLabel + ' ' + email;
          setTimeout(function () {
            textSpan.textContent = copyLabel;
          }, 2400);
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(email).then(markCopied).catch(function () {});
        }
      });
    })();
  </script>
</BaseLayout>
