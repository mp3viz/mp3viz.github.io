---
import { TRANSLATIONS, type Locale, getLocalizedPath } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = TRANSLATIONS[locale];
---

<footer class="mt-auto border-t border-line bg-card/70 py-10">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-4 text-center sm:flex-row sm:px-6 sm:text-left">
    <div class="space-y-1.5">
      <div class="flex items-center justify-center gap-2 sm:justify-start">
        <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-accent text-accent-fg">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
            <path d="M8 15V9" />
            <path d="M12 17V7" />
            <path d="M16 15V9" />
          </svg>
        </span>
        <span class="font-bold tracking-tight text-ink">MP3Viz</span>
      </div>
      <p class="text-sm text-ink-muted">{t.footer.tagline}</p>
      <p class="text-xs text-ink-muted">{t.footer.privacyNote}</p>
    </div>

    <div class="flex flex-col items-center gap-3 sm:items-end">
      <div class="flex flex-wrap items-center justify-center gap-4 text-sm font-medium text-ink-muted">
        <a href={getLocalizedPath(locale, '')} class="hover:text-ink studio-transition">
          {t.nav.home}
        </a>
        <a href={getLocalizedPath(locale, 'how-to-use/')} class="hover:text-ink studio-transition">
          {t.nav.howToUse}
        </a>
        <a href={getLocalizedPath(locale, 'hire-me/')} class="hover:text-ink studio-transition">
          {t.nav.hireMe}
        </a>
        <a
          href="https://kisharadilshan.gumroad.com/coffee"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-ink studio-transition"
        >
          {t.nav.supportDev}
        </a>
      </div>
      <p class="text-xs text-ink-muted">{t.footer.copyright}</p>
    </div>
  </div>
</footer>
